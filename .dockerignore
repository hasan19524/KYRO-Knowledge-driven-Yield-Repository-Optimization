# KYRO Docker build-context exclusions.
# Secrets must NEVER enter an image layer.
# NOTE: Docker .dockerignore uses filepath.Match semantics WITHOUT .gitignore-style
# recursion, so nested files need explicit `**/` patterns.

# env / secrets (all directories)
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
**/*.pem
**/*.key
secrets
**/secrets
credentials
**/credentials

# VCS
.git
.gitignore

# dependencies / build artifacts
**/node_modules
**/.next
out
**/out
build
**/build
coverage
**/coverage

# python artifacts
**/__pycache__
*.pyc
**/*.pyc
.venv
**/.venv
venv
**/venv
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
**/*.egg-info

# local data / logs
*.log
**/*.log
*.sql.gz
kafka/verify/.venv
kafka/verify/kafka-verify-state.json

# docs / CI / misc not needed inside images
.github
README.md
frontend/README.md
backend/README.md
kafka/README.md
**/*.tsbuildinfo
frontend/refrence.png
