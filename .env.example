# ============================================================================
# KYRO environment configuration template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
#
# Values differ by execution context:
#   [HOST]   = processes started manually on the host (dev/tests)
#   [DOCKER] = services started by infra/ or app/ compose stacks
#              (service-DNS names — NEVER localhost between containers)
#   [PROD]   = production hardening notes
# ============================================================================

# ----------------------------------------------------------------------------
# LLM (required for chat/RAG answers)
# ----------------------------------------------------------------------------
# [HOST] http://localhost:8101  is NOT used; Gemini is an external SaaS.
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# PostgreSQL — SOURCE OF TRUTH  (used by: app/config.py -> db, alembic/env.py)
# ----------------------------------------------------------------------------
# [HOST]   DATABASE_URL=postgresql+psycopg://kyro:kyro@localhost:5433/kyro
# [DOCKER] DATABASE_URL=postgresql+psycopg://kyro:kyro@kyro-postgres:5432/kyro
# [PROD]   use a strong password + managed PostgreSQL; never default creds.
DATABASE_URL=postgresql+psycopg://kyro:kyro@kyro-postgres:5432/kyro
POSTGRES_USER=kyro
POSTGRES_PASSWORD=kyro
POSTGRES_DB=kyro

# ----------------------------------------------------------------------------
# ChromaDB — SEMANTIC INDEX  (used by: app/ingest/indexer.py)
# ----------------------------------------------------------------------------
# [HOST]   CHROMA_URL=http://localhost:8100
# [DOCKER] CHROMA_URL=http://kyro-chroma:8000
CHROMA_URL=http://kyro-chroma:8000
CHROMA_COLLECTION=kyro_changes

# ----------------------------------------------------------------------------
# Kafka — EVENT BUFFER  (used by: app/kafka/*, app/sync/manager.py)
# ----------------------------------------------------------------------------
# [HOST]   KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# [DOCKER] KAFKA_BOOTSTRAP_SERVERS=kyro-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=kyro-kafka:29092

# ----------------------------------------------------------------------------
# n8n (stack A only)
# ----------------------------------------------------------------------------
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# N8N_ENCRYPTION_KEY=            # set to a stable random string to keep
#                                # credentials decryptable across volume loss

# ----------------------------------------------------------------------------
# GitHub App — KYRO -> GitHub authentication (NOT user auth)
# Required for onboarding/backfill/live-content resolution.
# Unit tests must NOT require these (they are mocked in tests/).
# [PROD] provide the private key via file, not env:
#   GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key.pem
# ----------------------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# ----------------------------------------------------------------------------
# KYRO API authentication (User -> KYRO)
# Required on protected endpoints: POST /api/query, POST /api/repositories/onboard,
# POST /api/repositories/{id}/resync. Reads (GET /health, GET /api/repositories)
# stay open. Leave EMPTY to disable auth (local dev only — NEVER in production).
# The browser never sees this key: the Next.js proxy injects it server-side.
# ----------------------------------------------------------------------------
KYRO_API_KEY=

# ----------------------------------------------------------------------------
# Frontend (app stack)
# ----------------------------------------------------------------------------
# Server-side proxy target — [DOCKER] service DNS, [HOST] localhost:
KYRO_BACKEND_URL=http://kyro-backend:8000

# ----------------------------------------------------------------------------
# Tunables (all optional — defaults shown; see app/config.py)
# ----------------------------------------------------------------------------
# WORKER_CONCURRENCY=2
# SYNC_SUPERVISOR_ENABLED=1
# SYNC_SUPERVISOR_INTERVAL_S=5.0
# SYNC_TIMEOUT_S=300.0
# SYNC_CONCURRENCY=2
# SYNC_PUBLISH_BATCH=50
# MAX_EVENT_ATTEMPTS=5
# QUERY_TOP_K=8
# QUERY_CONTEXT_MAX_CHARS=6000
# QUERY_PATCH_MAX_CHARS=1500
# GITHUB_TIMEOUT_S=30
# GITHUB_MAX_RETRIES=5
# GITHUB_RATE_LIMIT_MAX_WAIT_S=60
