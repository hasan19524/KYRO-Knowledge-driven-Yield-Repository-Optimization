# ============================================================================
# KYRO environment configuration template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
#
# Values differ by execution context:
#   [HOST]   = processes started manually on the host (dev/tests)
#   [DOCKER] = services started by infra/ or app/ compose stacks
#              (service-DNS names — NEVER localhost between containers)
#   [PROD]   = production hardening notes
#
# THREE ENV FILES, ONE OWNER EACH (this file mirrors the root .env = [DOCKER]):
#   root .env           container mode: infra/ (--env-file) + app/ (env_file)
#   backend/.env        native (host) backend/worker/alembic — loaded by
#                       app/config.py; DB/Chroma/Kafka stay ABSENT there because
#                       config.py defaults already target 127.0.0.1
#   frontend/.env.local native (host) `next dev` (auto-loaded by Next.js)
# Keys present in more than one file MUST be identical — verify anytime with:
#   python scripts/check_env_sync.py
# ============================================================================

# ----------------------------------------------------------------------------
# LLM provider chain (required for chat/RAG answers)
# Order/fallback: see LLM_PROVIDER_ORDER + app/llm_chain.py. Keys marked
# [HOST] belong in backend/.env too (host processes never read the root .env).
# ----------------------------------------------------------------------------
# [HOST] http://localhost:8101  is NOT used; Gemini is an external SaaS.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash        # override when Google rotates versions
# [HOST] also required in backend/.env (nvidia -> openrouter -> gemini chain):
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_MODEL=qwen/qwen3.8-omni-flash
# LLM_PROVIDER_ORDER=opencode,nvidia,openrouter,gemini
# LLM_HTTP_TIMEOUT_S=60

# ----------------------------------------------------------------------------
# PostgreSQL — SOURCE OF TRUTH  (used by: app/config.py -> db, alembic/env.py)
# ----------------------------------------------------------------------------
# [HOST]   DATABASE_URL=postgresql+psycopg://kyro:kyro@127.0.0.1:5433/kyro
#          (host URLs use 127.0.0.1 — "localhost" resolves ::1 first on
#          Windows and stalls libpq connections against Docker's mapped ports)
# [DOCKER] DATABASE_URL=postgresql+psycopg://kyro:kyro@kyro-postgres:5432/kyro
# [PROD]   use a strong password + managed PostgreSQL; never default creds.
DATABASE_URL=postgresql+psycopg://kyro:kyro@kyro-postgres:5432/kyro
POSTGRES_USER=kyro
POSTGRES_PASSWORD=kyro
POSTGRES_DB=kyro

# ----------------------------------------------------------------------------
# ChromaDB — SEMANTIC INDEX  (used by: app/ingest/indexer.py)
# ----------------------------------------------------------------------------
# [HOST]   CHROMA_URL=http://127.0.0.1:8100
# [DOCKER] CHROMA_URL=http://kyro-chroma:8000
CHROMA_URL=http://kyro-chroma:8000
CHROMA_COLLECTION=kyro_changes

# ----------------------------------------------------------------------------
# Kafka — EVENT BUFFER  (used by: app/kafka/*, app/sync/manager.py)
# ----------------------------------------------------------------------------
# [HOST]   KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# [DOCKER] KAFKA_BOOTSTRAP_SERVERS=kyro-kafka:29092
KAFKA_BOOTSTRAP_SERVERS=kyro-kafka:29092

# ----------------------------------------------------------------------------
# n8n (stack A only)
# ----------------------------------------------------------------------------
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
# N8N_ENCRYPTION_KEY=            # set to a stable random string to keep
#                                # credentials decryptable across volume loss
#
# GitHub webhook HMAC-SHA256 shared secret [DOCKER -> kyro-n8n env].
# Generate a real random value (e.g. 64 hex chars) and keep it secret.
# GitHub signs the raw webhook body with it and sends the digest in the
# X-Hub-Signature-256 header; the n8n "Verify HMAC" node rejects requests
# that fail verification with HTTP 401 before anything reaches Kafka.
# If unset, EVERY webhook delivery is rejected (fail closed).
# To rotate: change the value here, recreate n8n with the root env file:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --force-recreate kyro-n8n
# (compose resolves ${KYRO_WEBHOOK_SECRET} from --env-file because the compose
# project directory is infra/ - it does NOT auto-load the root .env), then
# update the Webhook secret in the GitHub App configuration.
KYRO_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# GitHub App — KYRO -> GitHub authentication (NOT user auth)
# Required for onboarding/backfill/live-content resolution.
# Unit tests must NOT require these (they are mocked in tests/).
# [DOCKER] inline PEM below (double-quoted, may span lines — compose parses it;
#          the file is git-ignored) because the Windows key path does not
#          exist inside Linux containers. auth.py prefers inline over path.
# [HOST]   backend/.env uses GITHUB_APP_PRIVATE_KEY_PATH (leave inline empty
#          there if you prefer, but BOTH files' PATH/ID values must match).
# [PROD] provide the private key via file, not env:
#   GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key.pem
# ----------------------------------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# ----------------------------------------------------------------------------
# KYRO API authentication (User -> KYRO)
# Required (X-API-Key) on every /api/* endpoint: a per-user key (kyro_...)
# or the shared service key below. /api/users additionally requires the
# shared (admin) key. Only GET /health stays open.
# Leave EMPTY to disable auth (local dev only — NEVER in production).
# The browser never sees this key: the Next.js proxy injects it server-side.
# [HOST] MANDATORY in BOTH backend/.env AND frontend/.env.local — host-run
# code never reads this root file. The test suite forces "" hermetically
# (backend/tests/conftest.py), so setting it never affects test outcomes.
# Verify all copies match: python scripts/check_env_sync.py
# ----------------------------------------------------------------------------
KYRO_API_KEY=

# ----------------------------------------------------------------------------
# Frontend (app stack)
# ----------------------------------------------------------------------------
# Server-side proxy target — [DOCKER] service DNS, [HOST] localhost:
KYRO_BACKEND_URL=http://kyro-backend:8000

# ----------------------------------------------------------------------------
# Tunables (all optional — defaults shown; see app/config.py)
# ----------------------------------------------------------------------------
# WORKER_CONCURRENCY=2
# SYNC_SUPERVISOR_ENABLED=1
# SYNC_SUPERVISOR_INTERVAL_S=5.0
# SYNC_TIMEOUT_S=300.0
# SYNC_CONCURRENCY=2
# SYNC_PUBLISH_BATCH=50
# MAX_EVENT_ATTEMPTS=5
# QUERY_TOP_K=8
# QUERY_CONTEXT_MAX_CHARS=6000
# QUERY_PATCH_MAX_CHARS=1500
# Retrieval quality: over-fetch factor for top-K at the Chroma call
# (guards against duplicates crowding out distinct chunks before
# de-duplication) and a cosine similarity floor (1 - distance) below
# which candidates are dropped before context assembly.
# QUERY_RETRIEVAL_OVERFETCH=4
# QUERY_SIMILARITY_THRESHOLD=0.1
# GITHUB_TIMEOUT_S=30
# GITHUB_MAX_RETRIES=5
# GITHUB_RATE_LIMIT_MAX_WAIT_S=60

# --- Security surface (optional) -------------------------------------------
# Interactive API docs: auto (default) = on only when KYRO_API_KEY is unset;
# on/off forces either way. Production leaves KYRO_API_KEY set => docs off.
# KYRO_DOCS=auto
# Allowed browser origins for CORS (comma-separated).
# CORS_ORIGINS=http://localhost:3000
# Per-user fixed-window rate limits (requests per minute; 0 disables).
# NOTE: all shared-service-key traffic (app + load tests + tunnel visitors)
# shares ONE bucket; the demo/telemetry setup uses 300 (strict default: 60).
# RATE_LIMIT_QUERY_PER_MIN=60
# RATE_LIMIT_RESYNC_PER_MIN=10
# Upper bound on POST /api/query "question" length (422 when exceeded).
# QUERY_MAX_QUESTION_CHARS=2000

# --- Account login (additive sessions; optional) ---------------------------
# Server-side lifetime of login sessions (POST /api/auth/login). Only
# SHA-256 hashes of session tokens are stored; logout deletes the row.
# AUTH_SESSION_TTL_HOURS=168
# Pre-auth fixed-window limits keyed on the normalized email (0 disables).
# RATE_LIMIT_REGISTER_PER_MIN=10
# RATE_LIMIT_LOGIN_PER_MIN=10
# Next.js proxy: set Secure on the kyro_session cookie (default on in
# production; set to 0 for plain-http local/docker deployments).
# KYRO_COOKIE_SECURE=1
